# ── UniTalk ASD full evaluation pipeline ──────────────────────────────────────
#
#
# Build (COPY paths are relative to the build context given in the build command, i.e. .):
#   docker build -f docker/Dockerfile_GPU -t unitalk-gpu_buffer .
#
# Run (download + predictions + stats):
#   docker run -d --gpus all -v $(pwd)/data:/app/data unitalk-gpu_buffer --data_dir /app/data
#
# Skip download and pick architecture / output folder (args replace CMD, so repeat --data_dir):
#   docker run -d --gpus all -v /Data/data:/app/data unitalk-gpu_buffer \
#       --data_dir /app/data --no_download \
#       --predictions_dir predictions_cnn1d_scores --architecture CNN2Plus1D
#
# Predictions only (no stats): append --skip_stats
#




FROM nvcr.io/nvidia/tensorflow:24.05-tf2-py3

LABEL org.opencontainers.image.title="UniTalk ASD Pipeline" \
      org.opencontainers.image.description="Download + evaluate ASD on UniTalk val split"

# create non-root User
ARG USERNAME=developer
ARG USER_UID=1000
ARG USER_GID=$USER_UID

# Create the user
RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m $USERNAME 

# ── System packages ────────────────────────────────────────────────────────────
# ffmpeg         : H264 video encoding used by FFmpegWriter
# curl           : dataset download (dowload_uni_talk.py uses curl subprocess)
# git            : required to pip-install pypaz directly from GitHub
# libgl1         : OpenCV runtime dependency (libGL.so.1)
# libglib2.0-0   : OpenCV runtime dependency (libgthread-2.0.so.0)
# build-essential: gcc/g++/make required to compile dlib from source
# cmake          : build system required by dlib's CMake-based build
# libopenblas-dev: BLAS library for dlib linear algebra routines
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        curl \
        git \
        libgl1 \
        libglib2.0-0 \
        build-essential \
        cmake \
        libopenblas-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app




# ── Python dependencies ────────────────────────────────────────────────────────
COPY pyproject.toml .
COPY README.md .
# Create the empty src directory so setuptools doesn't crash
RUN mkdir src
# Install dependencies using a persistent pip cache
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install .[dev] 





RUN pip install tensorflow[and-cuda]==2.18.0

# Use TF's pip-bundled CUDA/cuDNN 9.3 instead of the base image's cuDNN 9.1
ENV NV_PIP_LIB=/usr/local/lib/python3.10/dist-packages/nvidia
ENV LD_LIBRARY_PATH=${NV_PIP_LIB}/cudnn/lib:${NV_PIP_LIB}/cublas/lib:${NV_PIP_LIB}/cuda_runtime/lib:${NV_PIP_LIB}/cuda_nvrtc/lib:${NV_PIP_LIB}/cufft/lib:${NV_PIP_LIB}/curand/lib:${NV_PIP_LIB}/cusolver/lib:${NV_PIP_LIB}/cusparse/lib:${NV_PIP_LIB}/nccl/lib:${LD_LIBRARY_PATH}

# RUN python src/initialize_models.py
# TODO: this needs to come back as soon as the pipeline is fixed


#### TalkNet
COPY src/TalkNet-ASD/requirement.txt           src/TalkNet-ASD/requirement.txt
RUN pip install -r src/TalkNet-ASD/requirement.txt


# ── Application source ────────────────────────────────────────────────────────
COPY src/           src/

RUN pip install --no-deps -e ".[dev]"

# ── Data volume ───────────────────────────────────────────────────────────────
# Mount a volume here to persist downloaded data and evaluation outputs across
# container runs.  Expected sub-directories created by the pipeline:
#   data/csv/              annotation CSVs (val_orig.csv)
#   data/videos/val/       full YouTube videos (if --download_videos is set)
#   data/clips_videos/val/ short clip videos (downloaded by default)
#   data/clips_audios/val/ short clip audio  (downloaded by default)
#   data/output_videos/val annotated output MP4s
#   data/<predictions_dir>/      per-video prediction CSVs + aggregate_time.csv
#   data/stats/<predictions_dir>/ per-video detail CSVs + aggregate_results.csv
#   data/logs_stats/             stats log files
VOLUME ["/app/data"]

# ── Entry point ───────────────────────────────────────────────────────────────
# Default behaviour: download the dataset, predict on all val videos, then score them.
# Any extra flags passed to `docker run` replace CMD and are forwarded
# to run_evaluation.py (e.g. --no_download, --video ID, --skip_stats).
ENTRYPOINT ["python", "-m", "src.experiments.run_evaluation"]
CMD ["--data_dir", "/app/data"]
USER $USERNAME
