#!/bin/bash
# Benchmark on the DFKI cluster (#93): one Slurm array task per model x dataset x boxes run.
#
#   sbatch --array=0-71 cluster/benchmark.slr          # all 9 x 4 x 2 runs
#   sbatch --array=0-71%8 cluster/benchmark.slr        # at most 8 at the same time
#   bash cluster/benchmark.slr --list                  # print the index of every run
#
# Finished runs (stats/summary.json exists) are skipped, so failed tasks can simply be resubmitted.
# Afterwards build one table from all runs with the --collect_only line in cluster/README.md.
#SBATCH --job-name=asd4hri_benchmark
#SBATCH --partition=gpu_titan
#SBATCH --account=deepl
#SBATCH --time=1-00:00:00
#SBATCH -N 1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --output=logs/slurm_%A_%a.log

# paths on the cluster; override with environment variables when submitting
IMAGE=$(readlink -f "${IMAGE:-$HOME/SCRATCH/images/asd4hri.sif}")
# holds ava/ videos/ csv/ wasd/ easycom/; benchmark/ and logs/ are written here
DATA=${DATA:-$HOME/SCRATCH/asd4hri}
DATA=$(readlink -f "$DATA")         # ~/SCRATCH is a link; bind the real folder
TAG=${TAG:-cluster}

MODELS=(LipShapeCausal FaceShapeCausal CNN2Plus1D_Light AV:LR-ASD AV:TalkNet
        AV:Light-ASD AV:LRX-ASD AV:FabuLight AV:CAST-ASD)
DATASETS=(unitalk wasd easycom ava)
BOXES=(gt detector)

RUNS=()
for d in "${DATASETS[@]}"; do
  for m in "${MODELS[@]}"; do
    for b in "${BOXES[@]}"; do RUNS+=("$d $m $b"); done
  done
done

if [ "$1" = "--list" ]; then
  # 2>/dev/null: no "Broken pipe" noise when the list is piped into head
  for i in "${!RUNS[@]}"; do echo "$i ${RUNS[$i]}"; done 2>/dev/null
  exit 0
fi

read -r DATASET MODEL BOX <<< "${RUNS[${SLURM_ARRAY_TASK_ID:?submit with sbatch --array}]}"
echo "task $SLURM_ARRAY_TASK_ID on $(hostname): $DATASET $MODEL $BOX"
mkdir -p "$DATA/logs" "$DATA/home"
# --containall drops the environment, and with it the GPU Slurm assigned to this task: without this
# line every task sees all GPUs of the node and runs on GPU 0, also when that GPU is someone else's
export SINGULARITYENV_CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:?no GPU assigned by Slurm}
echo "GPU: CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"
# The libraries in the container see all cores of the node, not the CPUs Slurm gave this task, and
# each starts that many threads; on a shared node they then fight over the few cores the task has.
# Limit every thread pool to the task's CPUs (SINGULARITYENV_ because --containall drops the rest).
THREADS=${SLURM_CPUS_PER_TASK:-8}
for v in OMP_NUM_THREADS OPENBLAS_NUM_THREADS MKL_NUM_THREADS TF_NUM_INTRAOP_THREADS \
         OPENCV_FOR_THREADS_NUM; do
  export "SINGULARITYENV_$v=$THREADS"
done
export SINGULARITYENV_TF_NUM_INTEROP_THREADS=2
echo "CPU: $(lscpu | sed -n 's/^Model name: *//p'), $THREADS threads per library"
singularity exec --nv --containall --home "$DATA/home" --bind "$DATA:/app/data" "$IMAGE" \
  bash -c "cd /app && python -m src.experiments.run_benchmark --data_dir /app/data --no_download \
    --tag $TAG --architectures $MODEL --datasets $DATASET --boxes $BOX"
